# Free cloud LLM — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional local LLM
ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Lightweight hybrid (BM25 + TF-IDF)
ENABLE_HYBRID_TFIDF=true

# Optional heavy embeddings / Qdrant
ENABLE_QDRANT=false
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=stock_documents

# Database
DATABASE_URL=sqlite:///./data/stock_intel.db

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Features
ENABLE_LIVE_DATA=true
SEED_DATA_ON_STARTUP=true
LOG_LEVEL=INFO
