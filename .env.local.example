# Local run — no Docker required
# Copy: cp .env.local.example .env

# Free cloud LLM (recommended) — https://console.groq.com/keys
# llama-3.1-8b-instant is fast and free-tier; leave blank to use heuristic fallbacks
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional local LLM fallback (Ollama)
ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Lightweight hybrid RAG (BM25 + in-process TF-IDF) — on by default, no extra services
ENABLE_HYBRID_TFIDF=true

# Optional heavy vector DB (local Qdrant + sentence-transformers)
ENABLE_QDRANT=false
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=stock_documents
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Database
DATABASE_URL=sqlite:///./data/stock_intel.db

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Live data (Yahoo Finance + Google News RSS)
ENABLE_LIVE_DATA=true
SEED_DATA_ON_STARTUP=true
LOG_LEVEL=INFO
