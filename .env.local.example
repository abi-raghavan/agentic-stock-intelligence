# Local run — no Docker required
# Copy: cp .env.local.example .env

# LLM (disabled locally — planner uses built-in fallback)
ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Vector DB (disabled locally — BM25-only RAG, no embedding download)
ENABLE_QDRANT=false
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=stock_documents
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Database
DATABASE_URL=sqlite:///./data/stock_intel.db

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Live data (works without Docker — uses Yahoo Finance + Google News RSS)
ENABLE_LIVE_DATA=true
SEED_DATA_ON_STARTUP=true
LOG_LEVEL=INFO
